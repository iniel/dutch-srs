{
  "name": "dutch-srs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "test:watch": "vitest",
    "convert": "node scripts/convert-anki.mjs",
    "convert:nt2lex": "node scripts/convert-nt2lex.mjs",
    "clean": "node scripts/clean-cards.mjs scripts/import/nt2lex.staging.json",
    "import:merge": "node scripts/import-merge.mjs",
    "a2:map": "node scripts/build-a2-mapping.mjs",
    "a2:idlists": "node scripts/build-a2-idlists.mjs",
    "enrich": "node scripts/enrich-cards.mjs",
    "import:nig": "node scripts/import-nig.mjs",
    "enrich:nig": "node scripts/enrich-cards.mjs --ids scripts/sources/nig-new-ids.json && node scripts/finish-nig.mjs",
    "finish:nig": "node scripts/finish-nig.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
